{
  "contract_name": "token",
  "version": "1.0.0",
  "network": "stellar/soroban",
  "description": "BST (Brain-Storm Token) — SEP-0041 fungible token with reward minting, vesting, staking, and airdrop support.",
  "functions": [
    {
      "name": "initialize",
      "doc": "Initialize the token contract with an admin address.",
      "inputs": [
        { "name": "admin", "type": "address" }
      ],
      "outputs": []
    },
    {
      "name": "name",
      "doc": "Return the token name ('Brain-Storm Token').",
      "inputs": [],
      "outputs": [{ "type": "string" }]
    },
    {
      "name": "symbol",
      "doc": "Return the token symbol ('BST').",
      "inputs": [],
      "outputs": [{ "type": "string" }]
    },
    {
      "name": "decimals",
      "doc": "Return the number of decimals (7).",
      "inputs": [],
      "outputs": [{ "type": "u32" }]
    },
    {
      "name": "balance",
      "doc": "Return the BST balance for an address.",
      "inputs": [
        { "name": "addr", "type": "address" }
      ],
      "outputs": [{ "type": "i128" }]
    },
    {
      "name": "total_supply",
      "doc": "Return the total minted token supply.",
      "inputs": [],
      "outputs": [{ "type": "i128" }]
    },
    {
      "name": "mint",
      "doc": "Mint tokens to an address. Admin only.",
      "inputs": [
        { "name": "to", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "outputs": []
    },
    {
      "name": "mint_reward",
      "doc": "Mint BST reward tokens to a student recipient. Admin only.",
      "inputs": [
        { "name": "recipient", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "outputs": []
    },
    {
      "name": "burn",
      "doc": "Burn tokens from the caller's own balance.",
      "inputs": [
        { "name": "from", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "outputs": []
    },
    {
      "name": "burn_from",
      "doc": "Burn tokens from another address using an allowance.",
      "inputs": [
        { "name": "spender", "type": "address" },
        { "name": "from", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "outputs": []
    },
    {
      "name": "transfer",
      "doc": "Transfer tokens from one address to another.",
      "inputs": [
        { "name": "from", "type": "address" },
        { "name": "to", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "outputs": []
    },
    {
      "name": "transfer_from",
      "doc": "Transfer tokens on behalf of another address using an allowance.",
      "inputs": [
        { "name": "spender", "type": "address" },
        { "name": "from", "type": "address" },
        { "name": "to", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "outputs": []
    },
    {
      "name": "approve",
      "doc": "Approve a spender to transfer up to an amount from the caller's balance.",
      "inputs": [
        { "name": "owner", "type": "address" },
        { "name": "spender", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "outputs": []
    },
    {
      "name": "allowance",
      "doc": "Return the current allowance for a spender from an owner.",
      "inputs": [
        { "name": "owner", "type": "address" },
        { "name": "spender", "type": "address" }
      ],
      "outputs": [{ "type": "i128" }]
    },
    {
      "name": "get_burn_stats",
      "doc": "Return aggregate burn statistics.",
      "inputs": [],
      "outputs": [{ "type": "BurnStats" }]
    }
  ],
  "types": {
    "BurnStats": {
      "fields": [
        { "name": "total_burned", "type": "i128" },
        { "name": "burn_count", "type": "u32" }
      ]
    },
    "VestingSchedule": {
      "fields": [
        { "name": "beneficiary", "type": "address" },
        { "name": "total_amount", "type": "i128" },
        { "name": "start_ledger", "type": "u32" },
        { "name": "cliff_ledger", "type": "u32" },
        { "name": "end_ledger", "type": "u32" },
        { "name": "claimed", "type": "i128" }
      ]
    }
  },
  "events": [
    {
      "name": "transfer",
      "topics": ["transfer", "from", "to"],
      "data": { "type": "i128" }
    },
    {
      "name": "approve",
      "topics": ["approve", "owner", "spender"],
      "data": { "type": "i128" }
    },
    {
      "name": "mint",
      "topics": ["mint", "to"],
      "data": { "type": "i128" }
    },
    {
      "name": "burn",
      "topics": ["burn", "from"],
      "data": { "type": "i128" }
    }
  ]
}
